# Supabase проекта
VITE_SUPABASE_URL=https://iutpxajgrjkbxapztsdr.supabase.co

# Ключ клиента (из настроек Supabase -> Settings -> API -> Project URL & Keys -> publishable key)
# Браузеру нужен именно publishable-ключ (sb_publishable_xxx), а не secret.
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_KEY

# Время окончания нормальной смены (в часах) — 18:00 = 18
VITE_NORM_HOURS=18
